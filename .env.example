# TradingDesk secrets. Copy to .env and fill in. Never commit .env.
# Everything that is NOT a secret lives in config.yaml.

# --- Alpaca (paper account) ---
# Paper key IDs start with "PK". A live key ("AK...") makes startup refuse to run.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Optional. If set, must be https://paper-api.alpaca.markets
# ALPACA_BASE_URL=

# Live trading guard. Leave unset. Only "true" (exactly) disables the paper-only check.
# ALLOW_LIVE=

# --- Anthropic (Newsie grading + Skeptic) ---
ANTHROPIC_API_KEY=

# --- Discord alerts ---
DISCORD_WEBHOOK_URL=

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with contact info, e.g. "TradingDesk you@example.com"
SEC_USER_AGENT=

# --- Optional news sources ---
# Newsfilter.io switches on automatically when this is set.
NEWSFILTER_API_KEY=

# --- Social sources (phase 5) ---
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
STOCKTWITS_ACCESS_TOKEN=

# --- Trade Desk login ---
# Don't type this by hand: run `python -m tradingdesk set-desk-password`.
# Only the Argon2id hash is stored. Required when desk.host isn't localhost.
DESK_PASSWORD_HASH=
